{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-mobile-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MACHINES",
        "class_name": "Machine"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Machine"]
    }
  ]
}